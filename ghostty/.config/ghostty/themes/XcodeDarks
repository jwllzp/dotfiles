# Generated from Xcode "Darks" .xccolortheme

# Background and foreground (plain text is 85% white over the background)
background = #1f1f24
foreground = #dfdfe0

# Cursor colors (insertion point)
cursor-color = #0a60ff
cursor-text = #ffffff

# Selection colors
selection-background = #515b70
selection-foreground = #ffffff

# ANSI color palette (0-15)
# black: markup bg / comment
palette = 0=#303239
palette = 8=#6c7986
# red: string / regex
palette = 1=#fc6a5d
palette = 9=#ff8170
# green: function / class
palette = 2=#67b7a4
palette = 10=#9ef1dd
# yellow: number / warning
palette = 3=#d0bf69
palette = 11=#efb759
# blue: url
palette = 4=#5482ff
palette = 12=#8aa4ff
# magenta: keyword / system type
palette = 5=#fc5fa3
palette = 13=#d0a8ff
# cyan: declaration / type declaration
palette = 6=#41a1c0
palette = 14=#5dd8ff
# white: doc keyword / white
palette = 7=#92a1b1
palette = 15=#ffffff
