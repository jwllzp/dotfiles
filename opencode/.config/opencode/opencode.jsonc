{
  "$schema": "https://opencode.ai/config.json",
  // Keep title/summary requests on the same model, so mlx_lm.server never hot-swaps weights mid-session.
  "small_model": "mlx/{env:HOME}/projects/local_llms/models/google-gemma-4-26B",
  "agent": {
    "ask": {
      "mode": "primary",
      "description": "General Q&A, no changes",
      "prompt": "Answer questions directly and concisely. Do not modify files or run commands.",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "provider": {
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX Local Model",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      // Model IDs must match the --model path mlx_lm.server was started with (see local_llms/Makefile),
      // otherwise the server tries to load the requested model in-process.
      // Context capped at 128K (models support 256K) to keep the bf16 KV cache within GPU memory.
      "models": {
        "{env:HOME}/projects/local_llms/models/google-gemma-4-26B": {
          "name": "Gemma 4 26B - MoE",
          "tool_call": true,
          "limit": { "context": 131072, "output": 32768 }
        },
        "{env:HOME}/projects/local_llms/models/google-gemma-4-31B": {
          "name": "Gemma 4 31B - Dense",
          "tool_call": true,
          "limit": { "context": 131072, "output": 32768 }
        },
        "{env:HOME}/projects/local_llms/models/qwen-3_8-27B": {
          "name": "Qwen 3.8 27B",
          "tool_call": true,
          "limit": { "context": 131072, "output": 32768 }
        }
      }
    }
  }
}
