{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "ask": {
      "mode": "primary",
      "description": "General Q&A, no changes",
      "prompt": "Answer questions directly and concisely. Do not modify files or run commands.",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "provider": {
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX Local Model",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "/Users/jwllz/projects/local_llms/models/google-gemma-4-26B": {
          "name": "Gemma 4 26B - MoE"
        },
		"/Users/jwllz/projects/local_llms/models/google-gemma4-31B": {
			"name": "Gemma 4 31B - Dense"
		},
		"/Users/jwllz/projects/local_llms/models/qwen-3_8-27B": {
			"name": "Qwen 3.8 27B"
		}
      }
    }
  }
}